# Maximum concurrent Chromium scans in one server process. Default: 1.
ACCESSFORGE_MAX_CONCURRENT_SCANS=1

# Maximum concurrent scans for a single client. Default: 1.
ACCESSFORGE_MAX_CONCURRENT_SCANS_PER_CLIENT=1

# Remote and demo scan limits per client in the rolling window. Defaults: 5 and 6.
ACCESSFORGE_SCAN_RATE_LIMIT=5
ACCESSFORGE_DEMO_RATE_LIMIT=6
ACCESSFORGE_RATE_LIMIT_WINDOW_MS=60000

# Client IP policy. Use "none" unless a trusted proxy is confirmed.
# On Render, set "render" only after verifying Cloudflare's CF-Connecting-IP
# header reaches the service. This mode ignores X-Forwarded-For and X-Real-IP.
ACCESSFORGE_TRUSTED_PROXY=none

# Optional HTTP Basic authentication for POST /api/scan only.
# Leave the password unset to disable the gate. Demo scans stay public.
# ACCESSFORGE_SCAN_AUTH_USER=accessforge
# ACCESSFORGE_SCAN_AUTH_PASSWORD=

# Optional: use a system Chromium instead of the Playwright-downloaded build.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

# Optional: only enable in a trusted container that requires --no-sandbox.
# PLAYWRIGHT_NO_SANDBOX=true

# Optional live Switch handoff. Run `npm run switch:setup` to write these
# server-only values to .env.local. The registration key is used once and is
# not required at runtime.
# SWITCH_REGISTRATION_KEY=
# SWITCH_BRIDGE_URL=http://127.0.0.1:53371
# SWITCH_AGENT_ID=
# SWITCH_AGENT_API_KEY=
# SWITCH_AGENT_NAME=accessforge-bridge
# SWITCH_ROOM_ID=
# SWITCH_ROOM_NAME=
# SWITCH_FIX_AGENT=accessforge-fix
# SWITCH_TEST_AGENT=accessforge-test
